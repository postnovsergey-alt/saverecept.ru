# ---- Хранилище ----
# SQLite (по умолчанию, ничего настраивать не нужно):
DATABASE_URL=sqlite:///./data/samobranka.db
# Postgres (когда перерастём SQLite):
# DATABASE_URL=postgresql+psycopg://samobranka:secret@db:5432/samobranka

MEDIA_DIR=./data/media

# ---- Доступ ----
# У каждого пользователя свой email+пароль (регистрация на /register).
# SECRET_KEY подписывает cookie-сессии. Длинная случайная строка,
# генерируется автоматически. Сменить руками: openssl rand -hex 32
SECRET_KEY=

# ---- Порт ----
# Скрипт деплоя подберёт свободный сам, если этот занят соседями.
WEB_PORT=8080

# ---- LLM: основной провайдер ----
# Gemini говорит на OpenAI-совместимом протоколе, поэтому адрес именно такой.
# Ключ: https://aistudio.google.com/apikey — заводите ОТДЕЛЬНЫЙ проект и не
# включайте на нём биллинг, иначе бесплатный тариф на проекте исчезает целиком.
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_API_KEY=
# Точные идентификаторы моделей у Google меняются. Посмотреть доступные:
#   python -m tools.check_llm --list
LLM_MODEL=gemini-flash-latest

# ---- LLM: запасной провайдер (необязательно) ----
# Подхватывается автоматически, если основной ответил ошибкой или упёрся в лимит.
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL=

# ---- Telegram ----
# Токен от @BotFather. Пусто = бот не запускается, сайт работает.
TELEGRAM_BOT_TOKEN=
# Публичный адрес сайта, чтобы бот давал рабочие ссылки
PUBLIC_BASE_URL=http://localhost:8080

# ---- Картинки ----
IMAGE_MAX_WIDTH=1280
IMAGE_THUMB_WIDTH=480
IMAGE_QUALITY=78
IMAGE_MAX_COUNT=4
